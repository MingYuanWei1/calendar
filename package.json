{
  "name": "school-calendar",
  "private": true,
  "scripts": {
    "typecheck": "tsc --noEmit && tsc -p tsconfig.designs.json --noEmit",
    "start": "node --env-file-if-exists=.env server/index.mjs",
    "dev": "node --env-file-if-exists=.env --watch server/index.mjs",
    "admin:create": "node --env-file-if-exists=.env scripts/admin.mjs",
    "test": "node --test tests/integration/*.test.mjs",
    "backup": "node --env-file-if-exists=.env scripts/backup.mjs",
    "samples": "node --env-file-if-exists=.env scripts/sample-events.mjs",
    "samples:exams": "node --env-file-if-exists=.env scripts/sample-exams.mjs",
    "build:cloudflare": "node scripts/build-cloudflare.mjs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260922.1",
    "esbuild": "^0.28.2",
    "qrcode": "^1.5.4",
    "typescript": "^5.9.3",
    "wrangler": "^4.136.3"
  },
  "dependencies": {
    "@fontsource/noto-sans-sc": "^5.3.0",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "html2canvas": "^1.4.1",
    "jose": "^6.2.12",
    "jspdf": "^4.2.1",
    "pdfjs-dist": "^6.3.289",
    "pdfkit": "^0.20.2",
    "pinyin-pro": "^3.29.4",
    "sharp": "^0.35.4",
    "unzipper": "^0.12.5",
    "zod": "^4.6.5"
  },
  "engines": {
    "node": ">=24.13.0"
  },
  "overrides": {
    "exceljs": {
      "uuid": "^11.1.1"
    }
  }
}
