HOST=127.0.0.1
PORT=3000
APP_ORIGIN=http://localhost:3000
DATA_DIR=.data
SCHOOL_NAME=学校校历
SCHOOL_NAME_EN=School calendar
SCHOOL_TIMEZONE=Asia/Shanghai
# For deployment behind an HTTPS reverse proxy:
# NODE_ENV=production
# APP_ORIGIN=https://calendar.your-school.example
# Only set this when the service is behind your controlled local reverse proxy.
# TRUST_PROXY=loopback
# Microsoft Entra ID: single school tenant, Web redirect URI:
# ${APP_ORIGIN}/api/school/callback
MICROSOFT_TENANT_ID=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# Local student preview only; forbidden in production or on a public host.
SSO_PREVIEW=false

# Worker origin
LLM_WORKER_URL=
LLM_WORKER_TOKEN=
