{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "school-calendar-api",
  "main": "dist/backend/worker.mjs",
  "no_bundle": true,
  "compatibility_date": "2026-09-23",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "observability": {"enabled": true},
  "durable_objects": {"bindings": [{"name":"SCHOOLS","class_name":"SchoolCalendar"}]},
  "migrations": [{"tag":"v1","new_sqlite_classes":["SchoolCalendar"]}],
  "images": {"binding":"IMAGES"},
  "vars": {"APP_ORIGIN":"https://calendar.keydion.com","SCHOOL_ID":"calendar","SCHOOL_NAME":"学校校历","SCHOOL_NAME_EN":"School calendar","SCHOOL_TIMEZONE":"Asia/Shanghai"}
}
